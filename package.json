{
  "name": "dva-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <26"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "scrape": "tsx server/scrapers/cli.ts",
    "scrape:drom": "tsx server/scrapers/cli.ts drom",
    "scrape:encar": "tsx server/scrapers/cli.ts encar",
    "scrape:beforward": "tsx server/scrapers/cli.ts beforward",
    "scrape:che168": "tsx server/scrapers/cli.ts che168",
    "scrape:autohome": "tsx server/scrapers/cli.ts autohome",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "got": "^15.0.3",
    "tough-cookie": "^6.0.1",
    "cheerio": "^1.2.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.34.5",
    "iconv-lite": "^0.7.2",
    "fast-xml-parser": "^4.5.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^25.6.0",
    "@types/tough-cookie": "^4.0.5",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
